local activeTagIndex = nil
local createdButtons = {}

local function forceApplyTag()
    if not activeTagIndex then return end
    local character = LocalPlayer.Character
    if not character then return end
    local head = character:FindFirstChild("Head")
    if not head then return end

    local existingTag = head:FindFirstChild("CreatorTag")
    if existingTag then return end

    local tagData = TAG_CONFIGS[activeTagIndex]

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CreatorTag"
    billboard.Size = UDim2.new(0, 220, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = head

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = tagData.Text
    label.TextColor3 = tagData.TextColor
    label.TextSize = 24
    label.Font = Enum.Font.SourceSansBold
    label.Parent = billboard

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2.5
    stroke.Color = Color3.fromRGB(0, 0, 0)
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
    stroke.Parent = label

    billboard.Parent = head
end

local function removeCurrentTag()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("Head") then
        local tag = character.Head:FindFirstChild("CreatorTag")
        if tag then tag:Destroy() end
    end
end

local function updateButtonStyles()
    for index, btn in ipairs(createdButtons) do
        local config = TAG_CONFIGS[index]
        if activeTagIndex == index then
            btn.BackgroundColor3 = config.ActiveBg
        else
            btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        end
    end
end

local function toggleTag(index)
    if activeTagIndex == index then
        activeTagIndex = nil
        removeCurrentTag()
    else
        removeCurrentTag()
        activeTagIndex = index
        forceApplyTag()
    end
    updateButtonStyles()
end

