local espEnabled = false
local activeEspObjects = {}

local function removeESPForPlayer(player)
    if activeEspObjects[player] then
        for _, obj in pairs(activeEspObjects[player]) do
            if obj then obj:Destroy() end
        end
        activeEspObjects[player] = nil
    end
end

local function isEnemy(player)
    if not LocalPlayer.Team then return true end
    return player.Team ~= LocalPlayer.Team
end

local function applyESPToCharacter(player, character)
    if not espEnabled or player == LocalPlayer or bannedPlayers[player] then return end
    
    removeESPForPlayer(player)
    activeEspObjects[player] = {}

    local head = character:WaitForChild("Head", 5)
    if not head then return end

    local enemy = isEnemy(player)
    local teamColor = enemy and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(186, 85, 211)
    local textColor = enemy and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(255, 255, 255)

    local highlight = Instance.new("Highlight")
    highlight.Name = "EspHighlight"
    highlight.Adornee = character
    highlight.FillColor = teamColor
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = character
    table.insert(activeEspObjects[player], highlight)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "EspTag"
    billboard.Size = UDim2.new(0, 200, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = head

    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "EspText"
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextSize = 14
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextColor3 = textColor
    textLabel.Parent = billboard

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(0, 0, 0)
    stroke.Parent = textLabel

    billboard.Parent = head
    table.insert(activeEspObjects[player], billboard)
end

local function setCharacterVisibility(player, visible)
    local char = player.Character
    if not char then return end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("Decal") then
            part.Transparency = visible and 0 or 1
        end
    end

    local head = char:FindFirstChild("Head")
    if head then
        local tag = head:FindFirstChild("TargetCustomTag")
        if tag then tag.Enabled = visible end
    end

    if not visible then
        removeESPForPlayer(player)
    else
        if espEnabled then
            applyESPToCharacter(player, char)
        end
    end
end

