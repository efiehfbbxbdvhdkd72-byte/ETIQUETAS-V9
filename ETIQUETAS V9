RunService.RenderStepped:Connect(function()
    for p, _ in pairs(bannedPlayers) do
        if p and p.Character then
            setCharacterVisibility(p, false)
        end
    end

    if not espEnabled then return end
    
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not bannedPlayers[player] then
            local char = player.Character
            if char and char:FindFirstChild("Head") and char:FindFirstChild("HumanoidRootPart") then
                if not activeEspObjects[player] or not char:FindFirstChild("EspHighlight") then
                    applyESPToCharacter(player, char)
                end

                local head = char.Head
                local root = char.HumanoidRootPart
                local billboard = head:FindFirstChild("EspTag")
                
                if billboard and myRoot then
                    local textLabel = billboard:FindFirstChild("EspText")
                    if textLabel then
                        local distance = math.floor((myRoot.Position - root.Position).Magnitude)
                        local tagText = ""
                        if customPlayerTags[player] then
                            tagText = customPlayerTags[player].Text .. " "
                        end
                        textLabel.Text = string.format("%s@%s\n[%dm]", tagText, player.Name, distance)
                    end
                end
            end
        end
    end
end)

