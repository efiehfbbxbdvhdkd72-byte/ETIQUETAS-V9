local function startPollDisplay()
    local notifSound = Instance.new("Sound")
    notifSound.SoundId = "rbxassetid://17208361335"
    notifSound.Volume = 1.0
    notifSound.Parent = screenGui
    notifSound:Play()
    notifSound.Ended:Connect(function() notifSound:Destroy() end)

    local qText = pollQuestionBox.Text ~= "" and pollQuestionBox.Text or "¿Qué prefieres?"
    local o1Text = optionLeftBox.Text ~= "" and optionLeftBox.Text or "Opción A"
    local o2Text = optionRightBox.Text ~= "" and optionRightBox.Text or "Opción B"
    local totalSeconds = tonumber(pollTimeBox.Text) or 10
    local baseCount = tonumber(baseVotersBox.Text) or 0

    local count1 = baseCount
    local count2 = 0

    apcQuestion.Text = qText
    btnOpt1.Text = string.format("%s (%d)", o1Text, count1)
    btnOpt2.Text = string.format("%s (%d)", o2Text, count2)
    apcTimer.Text = totalSeconds .. "s"
    activePollCard.Visible = true

    local connection1, connection2

    connection1 = btnOpt1.MouseButton1Click:Connect(function()
        playClickSound()
        count1 = count1 + 1
        btnOpt1.Text = string.format("%s (%d)", o1Text, count1)
    end)

    connection2 = btnOpt2.MouseButton1Click:Connect(function()
        playClickSound()
        count2 = count2 + 1
        btnOpt2.Text = string.format("%s (%d)", o2Text, count2)
    end)

    if currentPollThread then task.cancel(currentPollThread) end

    currentPollThread = task.spawn(function()
        for s = totalSeconds, 0, -1 do
            apcTimer.Text = s .. "s"
            task.wait(1)
        end

        connection1:Disconnect()
        connection2:Disconnect()
        activePollCard.Visible = false

        local winningOption = o1Text
        if count2 > count1 then
            winningOption = o2Text
        elseif count1 == count2 then
            winningOption = o1Text .. " y " .. o2Text
        end

        winnerLabel.Text = string.format('!Ha Ganado "%s"!', winningOption)
        darkOverlay.Visible = true

        task.wait(5)
        darkOverlay.Visible = false
    end)
end

