if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
    TextChatService.OnIncomingMessage = function(message)
        local properties = Instance.new("TextChatMessageProperties")
        
        if message.TextSource and message.TextSource.UserId == LocalPlayer.UserId and activeTagIndex then
            local tagData = TAG_CONFIGS[activeTagIndex]
            local tagPrefix = string.format('<font color="%s"><b>[%s]</b></font>', tagData.HexColor, tagData.Text)
            local coloredName = string.format('<font color="%s"><b>%s</b></font>', tagData.HexColor, LocalPlayer.DisplayName)
            local coloredColon = string.format('<font color="%s"><b>:</b></font>', tagData.HexColor)
            local coloredText = string.format('<font color="%s">%s</font>', tagData.HexColor, message.Text)
            
            properties.PrefixText = tagPrefix .. " " .. coloredName .. coloredColon
            properties.Text = coloredText
            return properties
        end

        if message.TextSource then
            for p, tagData in pairs(customPlayerTags) do
                if p.UserId == message.TextSource.UserId then
                    local tagPrefix = string.format('<font color="%s"><b>[%s]</b></font>', tagData.HexColor, tagData.Text)
                    local coloredName = string.format('<font color="%s"><b>%s</b></font>', tagData.HexColor, p.DisplayName)
                    local coloredColon = string.format('<font color="%s"><b>:</b></font>', tagData.HexColor)
                    local coloredText = string.format('<font color="%s">%s</font>', tagData.HexColor, message.Text)
                    
                    properties.PrefixText = tagPrefix .. " " .. coloredName .. coloredColon
                    properties.Text = coloredText
                    return properties
                end
            end
        end

        return properties
    end
end
