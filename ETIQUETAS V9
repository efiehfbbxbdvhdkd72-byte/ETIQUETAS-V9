local function createAdvancedColorPicker(parentFrame, posY, onColorApplied)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(0, 216, 0, 65)
    container.Position = UDim2.new(0, 12, 0, posY)
    container.BackgroundTransparency = 1
    container.Parent = parentFrame

    local colorBox = Instance.new("Frame")
    colorBox.Size = UDim2.new(0, 130, 0, 24)
    colorBox.Position = UDim2.new(0, 0, 0, 0)
    colorBox.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    colorBox.BorderSizePixel = 0
    colorBox.Parent = container

    local cbCorner = Instance.new("UICorner")
    cbCorner.CornerRadius = UDim.new(0, 4)
    cbCorner.Parent = colorBox

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.15, Color3.fromRGB(255, 0, 0)),
        ColorSequenceKeypoint.new(0.30, Color3.fromRGB(255, 255, 0)),
        ColorSequenceKeypoint.new(0.45, Color3.fromRGB(0, 255, 0)),
        ColorSequenceKeypoint.new(0.60, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.75, Color3.fromRGB(0, 0, 255)),
        ColorSequenceKeypoint.new(0.90, Color3.fromRGB(255, 0, 255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 255, 255))
    })
    gradient.Parent = colorBox

    local whiteSelector = Instance.new("Frame")
    whiteSelector.Size = UDim2.new(0, 14, 0, 14)
    whiteSelector.AnchorPoint = Vector2.new(0.5, 0.5)
    whiteSelector.Position = UDim2.new(0, 7, 0.5, 0)
    whiteSelector.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    whiteSelector.BorderSizePixel = 0
    whiteSelector.Parent = colorBox

    local wsCorner = Instance.new("UICorner")
    wsCorner.CornerRadius = UDim.new(1, 0)
    whiteSelector.Parent = colorBox

    local wsStroke = Instance.new("UIStroke")
    wsStroke.Thickness = 1.5
    wsStroke.Color = Color3.fromRGB(0, 0, 0)
    wsStroke.Parent = whiteSelector

    local cancelBtn = Instance.new("TextButton")
    cancelBtn.Size = UDim2.new(0, 40, 0, 24)
    cancelBtn.Position = UDim2.new(0, 134, 0, 0)
    cancelBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
    cancelBtn.BorderSizePixel = 0
    cancelBtn.Text = "Cancelar"
    cancelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    cancelBtn.TextSize = 9
    cancelBtn.Font = Enum.Font.SourceSansBold
    cancelBtn.Parent = container

    local cbCorner2 = Instance.new("UICorner")
    cbCorner2.CornerRadius = UDim.new(0, 4)
    cancelBtn.Parent = container

    local listoColBtn = Instance.new("TextButton")
    listoColBtn.Size = UDim2.new(0, 40, 0, 24)
    listoColBtn.Position = UDim2.new(0, 178, 0, 0)
    listoColBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 60)
    listoColBtn.BorderSizePixel = 0
    listoColBtn.Text = "Listo"
    listoColBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    listoColBtn.TextSize = 9
    listoColBtn.Font = Enum.Font.SourceSansBold
    listoColBtn.Parent = container

    local lcbCorner = Instance.new("UICorner")
    lcbCorner.CornerRadius = UDim.new(0, 4)
    listoColBtn.Parent = container

    local previewLabel = Instance.new("TextLabel")
    previewLabel.Size = UDim2.new(1, 0, 0, 28)
    previewLabel.Position = UDim2.new(0, 0, 0, 32)
    previewLabel.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    previewLabel.BorderSizePixel = 0
    previewLabel.Text = "Color seleccionado"
    previewLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    previewLabel.TextSize = 10
    previewLabel.Font = Enum.Font.SourceSansBold
    previewLabel.Parent = container

    local plCorner = Instance.new("UICorner")
    plCorner.CornerRadius = UDim.new(0, 4)
    previewLabel.Parent = container

    local currentColor = Color3.fromRGB(255, 255, 255)
    local draggingColor = false

    local function updateColorFromInput(inputX)
        local absolutePos = colorBox.AbsolutePosition.X
        local absoluteSize = colorBox.AbsoluteSize.X
        local relativeX = math.clamp(inputX - absolutePos, 0, absoluteSize)
        whiteSelector.Position = UDim2.new(0, relativeX, 0.5, 0)

        local alpha = relativeX / absoluteSize
        local keypoints = gradient.Color.Keypoints
        for i = 1, #keypoints - 1 do
            local kp1 = keypoints[i]
            local kp2 = keypoints[i+1]
            if alpha >= kp1.Time and alpha <= kp2.Time then
                local localAlpha = (alpha - kp1.Time) / (kp2.Time - kp1.Time)
                currentColor = kp1.Value:Lerp(kp2.Value, localAlpha)
                break
            end
        end
        previewLabel.TextColor3 = currentColor
    end

    colorBox.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingColor = true
            parentFrame.Draggable = false
            updateColorFromInput(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if draggingColor and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateColorFromInput(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if draggingColor then
                draggingColor = false
                parentFrame.Draggable = true
            end
        end
    end)

    cancelBtn.MouseButton1Click:Connect(function()
        playClickSound()
        currentColor = Color3.fromRGB(255, 255, 255)
        whiteSelector.Position = UDim2.new(0, 7, 0.5, 0)
        previewLabel.TextColor3 = currentColor
        onColorApplied(currentColor)
    end)

    listoColBtn.MouseButton1Click:Connect(function()
        playClickSound()
        onColorApplied(currentColor)
    end)
end

